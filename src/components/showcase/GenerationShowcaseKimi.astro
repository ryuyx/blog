---
import IconKimi from "@/assets/icons/IconKimi.svg";

const tokenLines = [
  ["我", "给", "自己", "定了", "十条", "规矩", "：", "一秒半", "内", "必须", "开口", "，", "说话", "要", "像", "挤牙膏", "一点", "一点", "给", "，", "代码", "必须", "整段", "输出", "，", "句号", "后", "假装", "思考", "停一停", "，", "绝不", "让", "你的", "浏览器", "卡顿", "，", "你", "说", "停", "我", "就", "停", "且", "能", "续上", "，", "只", "推送", "新", "内容", "不", "重绘", "全文", "，", "写", "长", "东西", "前", "先", "刷个", "“", "加载中", "”", "绝不", "抢", "你的", "输入框", "，", "最后", "——", "我", "知道", "什么", "时候", "该", "闭嘴", "。", "说完了", "，", "再见", "。"],
];

const TOKEN_DELAY_STEP = 92;
const LINE_DELAY_GAP = 430;
---

<div class="rounded-lg border border-gray bg-white px-3 py-3">
  <div class="mb-2 flex items-center gap-1.5 text-sm">
    <IconKimi class="h-4 w-4 opacity-80" aria-hidden="true" />
    <span class="font-medium">Kimi 生成中</span>
  </div>
  <div class="kimi-container space-y-2 text-sm leading-6">
    {
      tokenLines.map((line, lineIndex) => (
        <span class="kimi-line">
          {
            line.map((token, tokenIndex) => (
              <span
                class="kimi-token"
                style={`--token-delay: ${lineIndex * LINE_DELAY_GAP + tokenIndex * TOKEN_DELAY_STEP}ms;`}
              >
                {token}
              </span>
            ))
          }
        </span>
      ))
    }
  </div>
</div>

<script>
  const el = document.querySelector<HTMLElement>(".kimi-container");
  if (el) {
    const TOKEN_DELAY_STEP = 92;
    const tokensPerLine = [74];
    const totalTokens = tokensPerLine.reduce((a, b) => a + b, 0);
    const LOOP_DELAY = (totalTokens - 1) * TOKEN_DELAY_STEP + 3000;

    let timer: ReturnType<typeof setTimeout>;

    function revealTokens(container: HTMLElement) {
      const tokens = Array.from(container.querySelectorAll<HTMLElement>(".kimi-token"));
      tokens.forEach((t, i) => {
        setTimeout(() => {
          t.classList.add("revealed");
        }, i * TOKEN_DELAY_STEP);
      });
    }

    function resetAndReveal(container: HTMLElement) {
      const tokens = container.querySelectorAll<HTMLElement>(".kimi-token");
      tokens.forEach((t) => t.classList.remove("revealed"));
      clearTimeout(timer);
      timer = setTimeout(() => revealTokens(container), 50);
    }

    revealTokens(el);
    setInterval(() => resetAndReveal(el), LOOP_DELAY);
  }
</script>

<style>
  .kimi-line {
    line-height: 1.65;
  }

  .kimi-token {
    display: inline-block;
    opacity: 0;
    animation: none;
    transition: none;
  }

  .kimi-token.revealed {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .kimi-token {
      opacity: 1;
      transform: none;
      filter: none;
      animation: none;
    }
  }
</style>