---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { slugifyStr } from "@/utils/slugify";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, ...props } = data;
---

<li class="group py-5 first:pt-2">
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    class:list={[
      "text-foreground block text-base font-medium tracking-tight",
      "transition-colors hover:text-accent",
      "focus-visible:no-underline",
    ]}
  >
    <Heading
      transition:name={slugifyStr(title.replaceAll(".", "-"))}
      class="text-lg leading-snug"
    >
      {title}
    </Heading>
  </a>
  <Datetime class="mt-1.5" {...props} />
  <p class="text-muted-foreground mt-2 text-sm leading-relaxed">{description}</p>
</li>
